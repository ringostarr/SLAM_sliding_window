<?xml version="1.0"?>
<!--
  Differential-drive robot for the corridor SLAM challenge.
  Sensors: 16-channel 3D gpu_lidar + 6-axis IMU (Gazebo Harmonic).
  Plugins: DiffDrive (locomotion), JointStatePublisher, OdometryPublisher
           (ground-truth pose -> the noise node corrupts this in step B2).
-->
<robot name="corridor_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_sep"    value="0.32"/>
  <xacro:property name="chassis_x"    value="0.40"/>
  <xacro:property name="chassis_y"    value="0.24"/>
  <xacro:property name="chassis_z"    value="0.12"/>

  <!-- ===================== LINKS ===================== -->
  <link name="base_link">
    <inertial>
      <mass value="6.0"/>
      <inertia ixx="0.06" iyy="0.10" izz="0.12" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <visual>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="steel"><color rgba="0.3 0.45 0.7 1"/></material>
    </visual>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}">
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="0.04"/></geometry>
      </collision>
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="0.04"/></geometry>
        <material name="rubber"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_wheel"  y="${ wheel_sep/2}"/>
  <xacro:wheel name="right_wheel" y="${-wheel_sep/2}"/>

  <!-- passive caster -->
  <link name="caster">
    <inertial><mass value="0.2"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <visual><geometry><sphere radius="0.03"/></geometry></visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="0.15 0 ${-wheel_radius+0.03}"/>
  </joint>

  <!-- LiDAR -->
  <link name="lidar_link">
    <inertial><mass value="0.2"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision><geometry><cylinder radius="0.04" length="0.05"/></geometry></collision>
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material></visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.1 0 ${chassis_z/2+0.05}"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <inertial><mass value="0.02"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 ${chassis_z/2}"/>
  </joint>

  <!-- ===================== GAZEBO ===================== -->
  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/diff_odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <!-- Ground-truth odometry (from true model pose). The noise node in B2
         subscribes here and republishes a corrupted version. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_topic>/ground_truth/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- 16-channel 3D LiDAR -->
  <gazebo reference="lidar_link">
    <sensor name="lidar3d" type="gpu_lidar">
      <topic>/lidar</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>   <!-- -15 deg -->
            <max_angle>0.2618</max_angle>    <!-- +15 deg -->
          </vertical>
        </scan>
        <!-- Range limited to 8 m (closed corridor): from mid-corridor neither
             end cap is within range, so only the parallel side walls are seen
             and X is unobservable there; near the ends a cap comes into range
             and restores X observability. This is what makes lambda_min spike
             in the middle and recover at the ends. -->
        <range><min>0.1</min><max>8.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- 6-axis IMU (accel + gyro). Kept near-clean here; the assignment's gyro
       bias/drift is injected by the noise node, not by Gazebo. -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
